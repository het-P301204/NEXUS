# NEXUS server configuration. Copy to .env for local overrides; the
# server reads process.env only and never exposes these values to the browser.

# Port the API (and, in production, the built frontend) listens on.
PORT=8787

# The browser origin allowed to make state-changing requests. Requests whose
# Origin header does not match are refused before they reach a handler.
APP_ORIGIN=http://localhost:5173

# Demo mode enables the persona switcher, the scenario simulator, the ledger
# tamper simulation and the "reset demo data" action. Set to false and those
# endpoints return 404.
DEMO_MODE=true

# Where the SQLite database and the evidence object store live. Outside the
# web root; evidence is only ever served through an authorised endpoint.
STORAGE_DIR=./storage

# Maximum evidence upload size in bytes (default 10 MiB).
MAX_UPLOAD_BYTES=10485760

# Session lifetime in minutes, and idle timeout in minutes.
SESSION_TTL_MINUTES=480
SESSION_IDLE_MINUTES=60
